{
    "name": "fleetbase/core-api",
    "version": "2.0.0",
    "description": "Core Framework and Resources for Fleetbase API",
    "keywords": [
        "fleetbase",
        "logistics platform"
    ],
    "license": "AGPL-3.0-or-later",
    "authors": [
        {
            "name": "Fleetbase Pte Ltd.",
            "email": "hello@fleetbase.io"
        },
        {
            "name": "Ronald A. Richardson",
            "email": "ron@fleetbase.io"
        }
    ],
    "require": {
        "php": "^8.2",
        "aaronfrancis/fast-paginate": "^2.0",
        "aws/aws-sdk-php-laravel": "^3.7",
        "fleetbase/countries": "^0.9.0",
        "fleetbase/laravel-mysql-spatial": "^2.0",
        "fleetbase/twilio": "^6.0",
        "giggsey/libphonenumber-for-php": "^8.13",
        "google/apiclient": "^2.18",
        "guzzlehttp/guzzle": "^7.4",
        "illuminate/broadcasting": "^12.69|^13.0",
        "illuminate/contracts": "^12.69|^13.0",
        "illuminate/database": "^12.69|^13.0",
        "illuminate/http": "^12.69|^13.0",
        "illuminate/notifications": "^12.69|^13.0",
        "illuminate/routing": "^12.69|^13.0",
        "illuminate/support": "^12.69|^13.0",
        "inkrot/php-compress-json": "^0.1.1",
        "innoge/laravel-msgraph-mail": "^2.0",
        "intervention/image": "^3.11",
        "jdorn/sql-formatter": "^1.2",
        "laravel-notification-channels/apn": "^5.5",
        "laravel-notification-channels/fcm": "^5.1",
        "laravel-notification-channels/twilio": "^4.1",
        "laravel/sanctum": "^4.0",
        "laravel/socialite": "^5.31",
        "lcobucci/clock": "3.3.1",
        "lcobucci/jwt": "^5.4",
        "league/oauth2-server": "^8.5.5",
        "maatwebsite/excel": "^3.1",
        "milon/barcode": "^13.0",
        "mossadal/math-parser": "^1.3",
        "nyholm/psr7": "^1.5",
        "phpoffice/phpspreadsheet": "^1.30.7",
        "phrity/websocket": "^1.7",
        "pragmarx/google2fa": "^8.0",
        "rlanvin/php-rrule": "^2.4",
        "sentry/sentry-laravel": "*",
        "spatie/laravel-activitylog": "^4.7",
        "spatie/laravel-google-cloud-storage": "^2.2",
        "spatie/laravel-pdf": "^1.9",
        "spatie/laravel-permission": "^6.3",
        "spatie/laravel-responsecache": "^7.5",
        "spatie/laravel-schedule-monitor": "^3.7",
        "spatie/laravel-sluggable": "^3.5",
        "sqids/sqids": "^0.4.1",
        "symfony/psr-http-message-bridge": "^2.1|^6.0|^7.0",
        "xantios/mimey": "^2.2.0"
    },
    "require-dev": {
        "cknow/laravel-money": "^8.0",
        "friendsofphp/php-cs-fixer": "3.82.2",
        "illuminate/translation": "^12.69|^13.0",
        "illuminate/validation": "^12.69|^13.0",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.0",
        "pestphp/pest": "^3.0",
        "phpstan/phpstan": "^1.10.38",
        "symfony/var-dumper": "^7.0"
    },
    "autoload": {
        "psr-4": {
            "Fleetbase\\": "src/",
            "Fleetbase\\Seeders\\": "seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Fleetbase\\Tests\\": "tests/"
        }
    },
    "minimum-stability": "dev",
    "prefer-stable": true,
    "extra": {
        "laravel": {
            "providers": [
                "Fleetbase\\Providers\\CoreServiceProvider",
                "Fleetbase\\Providers\\EventServiceProvider",
                "Fleetbase\\Providers\\SocketClusterServiceProvider"
            ]
        }
    },
    "config": {
        "sort-packages": true,
        "preferred-install": "dist",
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "scripts": {
        "coverage:baseline": [
            "@test:coverage:clover",
            "@coverage:summary"
        ],
        "coverage:summary": "php scripts/coverage-summary.php coverage/clover.xml",
        "lint": "php-cs-fixer fix -v",
        "test:coverage": "php scripts/coverage-runner.php --coverage --coverage-text --colors=always",
        "test:coverage:clover": "mkdir -p coverage && php scripts/coverage-runner.php --coverage-clover=coverage/clover.xml --colors=always",
        "test:date-drift": "php scripts/check-test-date-drift.php",
        "test:lint": "php-cs-fixer fix -v --dry-run",
        "test:types": "phpstan analyse --ansi --memory-limit=-1",
        "test:unit": "php -d memory_limit=512M vendor/bin/pest --colors=always",
        "test": [
            "@test:lint",
            "@test:date-drift",
            "@test:types",
            "@test:unit"
        ]
    }
}
